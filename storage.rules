rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Profile pictures ─────────────────────────────────────────────────────
    // Users upload their own profile image. Path: /avatars/{userId}/{filename}
    match /avatars/{userId}/{fileName} {
      // Anyone signed in can read avatars (needed for provider profiles)
      allow read: if request.auth != null;

      // Only authenticated users can upload/overwrite (size ≤ 5 MB, images only)
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Training / academy content ───────────────────────────────────────────
    // Admin-uploaded videos, images, PDFs. Path: /training/{filename}
    match /training/{fileName} {
      allow read: if request.auth != null;
      // Only admin can write (enforced at app layer; no uid check since custom auth)
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024;
    }

    // ─── Mission attachments ──────────────────────────────────────────────────
    // Photos uploaded during a mission. Path: /missions/{missionId}/{filename}
    match /missions/{missionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
