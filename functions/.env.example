# Firebase Cloud Functions — server-side environment variables
# Copy this file to functions/.env and fill in real values.
# NEVER commit functions/.env — it contains secrets.
#
# Deploy to Firebase:
#   firebase functions:secrets:set JEKO_API_KEY
#   firebase functions:secrets:set JEKO_API_KEY_ID
#   firebase functions:secrets:set JEKO_STORE_ID
# Or use functions/.env for local emulator use only.

# Jèko Partner API (https://developer.jeko.africa)
JEKO_API_KEY=your_jeko_api_key_here
JEKO_API_KEY_ID=your_jeko_api_key_id_here
JEKO_STORE_ID=your_jeko_store_id_here

# Base URL for Jèko payment redirect callbacks
APP_BASE_URL=https://serviplus-f1b8f.web.app

# SMS provider (choose one when implementing sendSms)
# Option A — Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1234567890
#
# Option B — Orange SMS API
# ORANGE_SMS_CLIENT_ID=your_client_id
# ORANGE_SMS_CLIENT_SECRET=your_client_secret
